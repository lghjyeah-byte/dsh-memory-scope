{
  "name": "dsh-memory-scope",
  "version": "0.1.0-beta.1",
  "description": "DeepSeek Harness 原生长期记忆：办公工作区共享与会话隔离",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "long-term-memory",
    "session-memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.mjs"
  }
}
